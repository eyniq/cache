{
  "name": "@eyniq/cache",
  "version": "0.0.1",
  "description": "Pull-through npm registry cache with a minimum release age gate. Community edition.",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyniq/cache.git"
  },
  "bugs": {
    "url": "https://github.com/eyniq/cache/issues"
  },
  "homepage": "https://github.com/eyniq/cache#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0",
  "main": "dist/main.js",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/core/contracts.ts",
    "./defaults": "./src/defaults.ts",
    "./config": "./src/config.ts",
    "./log": "./src/core/log.ts",
    "./testing": "./src/testing/index.ts",
    "./npm": "./src/adapters/npm/public.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/web && cp -R src/web/static dist/web/",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/static/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:concurrency": "vitest run --project concurrency",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "load": "node load/run.ts",
    "load:compare": "node load/compare.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
